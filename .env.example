# Database Configuration
DATABASE_URL=postgresql://agistack:agistack_dev@localhost:5433/agistack
POSTGRES_USER=agistack
POSTGRES_PASSWORD=agistack_dev
POSTGRES_DB=agistack

# Redis Configuration
REDIS_URL=redis://:redis_dev@localhost:6380
REDIS_PASSWORD=redis_dev

# API Configuration
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001

# Frontend Configuration
WEB_PORT=3000
WEB_URL=http://localhost:3000

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AI Provider Keys (Optional - Add your own keys)
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-openai-xxx
GOOGLE_API_KEY=xxx

# pgAdmin Configuration (Optional)
PGADMIN_PORT=5051
PGADMIN_EMAIL=admin@agistack.local
PGADMIN_PASSWORD=admin

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
