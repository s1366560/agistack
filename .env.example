# Database Configuration
DATABASE_URL=postgresql://agistack:agistack_dev@localhost:5433/agistack
POSTGRES_USER=agistack
POSTGRES_PASSWORD=agistack_dev
POSTGRES_DB=agistack

# Redis Configuration
REDIS_URL=redis://:redis_dev@localhost:6380
REDIS_PASSWORD=redis_dev

# API Configuration
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
WS_PORT=3002

# Frontend Configuration
WEB_PORT=3000
WEB_URL=http://localhost:3000
WS_URL=ws://localhost:3002

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AI Provider Configuration
# Primary AI provider: anthropic, openai, google
AI_PROVIDER=anthropic

# AI model (optional - uses provider default if not specified)
# Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# Google: gemini-2.0-flash-exp, gemini-1.5-pro
AI_MODEL=claude-3-5-sonnet-20241022

# Custom Base URL (optional - for proxy or custom endpoints)
# Leave empty to use provider's default endpoint
AI_BASE_URL=

# AI Provider API Keys (Set at least one matching your provider)
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-openai-xxx
GOOGLE_API_KEY=xxx

# AI Generation Parameters (Optional)
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TOP_P=0.9
AI_MAX_RETRIES=3
AI_RETRY_DELAY=1000
AI_TIMEOUT=60000

# pgAdmin Configuration (Optional)
PGADMIN_PORT=5051
PGADMIN_EMAIL=admin@agistack.local
PGADMIN_PASSWORD=admin

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
