{
  "name": "@agistack/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.ts __tests__/integration",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:all": "bun run test:unit && bun run test:integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file ../../.env src/db/migrate.ts",
    "db:rollback": "bun --env-file ../../.env src/db/migrate.ts rollback",
    "db:seed": "bun --env-file ../../.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "ai": "^4.0.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.1",
    "helmet": "^8.1.0",
    "hono": "^4.11.5",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.0",
    "uuid": "^13.0.0",
    "ws": "^8.18.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.13.9",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.0",
    "@vitest/coverage-v8": "3.0.7",
    "@vitest/ui": "^4.0.18",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.8",
    "typescript": "5.8.2",
    "vitest": "3.0.7"
  }
}
